# Supabase
# NEXT_PUBLIC_* values are embedded in the browser bundle — use only the anon key, never the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App (lecturer + student deployment)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: separate platform-admin deployment (e.g. https://admin.lectrax.app)
# When set, /admin routes on this app redirect to the admin domain.
NEXT_PUBLIC_ADMIN_APP_URL=

# Admin deployment only — set on the admin app repository
# NEXT_PUBLIC_DEPLOYMENT_TARGET=admin
# NEXT_PUBLIC_MAIN_APP_URL=https://lectrax.app

# Monime Payment (https://monime.io)
# Server-only — never expose these in client code or NEXT_PUBLIC_* variables.
MONIME_API_KEY=your-monime-api-key
MONIME_WEBHOOK_SECRET=your-webhook-secret
MONIME_SPACE_ID=your-space-id
# Optional / informational — checkout sessions always charge in SLE from code defaults.
MONIME_CURRENCY=SLE
# Individual + partnership charge amounts come from code defaults (no env overrides).

# Attendance QR signing (min 32 chars)
# Server-only
QR_TOKEN_SECRET=change-this-to-a-long-random-secret-min-32-chars

# Subscription lifecycle cron (daily expiry checks & reminders)
# Server-only
CRON_SECRET=change-this-to-a-long-random-secret

# Assignment PDF antivirus (optional — deep PDF inspection always runs)
# Server-only — get a key at https://www.virustotal.com/
# VIRUSTOTAL_API_KEY=your-virustotal-api-key
# Require antivirus in production (fails uploads when key is missing):
# SUBMISSION_ANTIVIRUS_REQUIRED=false

# Content-Security-Policy mode (nonce + strict-dynamic; no script 'unsafe-inline')
# report-only (default) — logs violations to /api/csp-report without blocking
# enforce — blocking Content-Security-Policy (flip after Report-Only is clean)
# off — emergency disable
# CSP_MODE=report-only