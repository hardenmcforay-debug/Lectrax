# Copy to loadtests/k6/.env (never commit secrets)

BASE_URL=http://localhost:3000
SCALE=100
THRESHOLD_PROFILE=standard
ALLOW_RATE_LIMITS=true
THINK_TIME_S=1

# Users — prefer a JSON file with many unique accounts for high SCALE
USERS_FILE=data/users.json
# Or synthetic (must exist in Supabase staging):
# SYNTHETIC_USER_COUNT=1000
# SYNTHETIC_EMAIL_DOMAIN=loadtest.lectrax.local
# SYNTHETIC_PASSWORD=LoadTest!pass1

LECTURER_IDENTIFIER=lecturer.loadtest@example.com
LECTURER_PASSWORD=ChangeMe!Load1

# Scenario fixtures (staging UUIDs)
CLASS_SESSION_ID=
ASSIGNMENT_ID=
TEST_ID=
ENROLLMENT_IDS=

# Attendance
# ATTENDANCE_SESSION_ID=
# QR_TOKEN=
# TOKEN_FEED_URL=http://127.0.0.1:9091/
ATTENDANCE_WINDOW_MIN=15
FEED_PORT=9091

# Payments — keep dry-run on unless using staging Monime
PAYMENT_DRY_RUN=true
# PAYMENT_PLAN=monthly
# PAYMENT_METHOD=orange_money

# Required for SCALE=50000 or 100000 on real profiles
# ALLOW_DISTRIBUTED_SCALE=true
# MAX_VUS=10000

# Analytics export (expensive)
RUN_EXPORT=false
