# Copy to .env.test (gitignored) for local Vitest / Playwright runs.
# CI injects equivalent non-placeholder values — never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://ci-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ci-anon-key-for-tests-only
SUPABASE_SERVICE_ROLE_KEY=ci-service-role-key-for-tests-only
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
QR_TOKEN_SECRET=ci-qr-token-secret-min-32-characters-long!!
CRON_SECRET=ci-cron-secret-for-e2e-tests

# Optional: authenticated Playwright flows (skipped when unset)
# E2E_LECTURER_IDENTIFIER=
# E2E_LECTURER_PASSWORD=
# E2E_STUDENT_IDENTIFIER=
# E2E_STUDENT_PASSWORD=

# Payments / webhooks (unit tests use HMAC fixtures)
MONIME_API_KEY=ci-monime-api-key-for-tests
MONIME_SPACE_ID=ci-monime-space-id
MONIME_WEBHOOK_SECRET=ci-monime-webhook-secret-for-tests
MONIME_CURRENCY=SLE
